@{
    ViewData["Title"] = "จัดการข้อมูลหลัก (ผู้ใช้ & สิทธิวันลา)";
    var users = ViewBag.Users as List<LeaveSystem.Models.User>;
    var balances = ViewBag.Balances as List<LeaveSystem.Models.LeaveBalance>;
}

<div class="container py-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">👤 เพิ่มข้อมูลผู้ใช้ (พนักงาน)</div>
                <div class="card-body">
                    <form asp-action="AddUser" method="post">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">รหัสพนักงาน</label>
                            <input type="text" name="EmployeeCode" class="form-control" placeholder="เช่น EMP003" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">ชื่อ-นามสกุล</label>
                            <input type="text" name="FullName" class="form-control" placeholder="ชื่อ นามสกุล" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">แผนก</label>
                            <input type="text" name="Department" class="form-control" placeholder="เช่น IT, HR" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">บทบาท</label>
                            <select name="Role" class="form-select">
                                <option value="Employee">Employee (พนักงาน)</option>
                                <option value="Admin">Admin (ผู้พิจารณา)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-dark w-100">+ บันทึกผู้ใช้</button>
                    </form>

                    <hr />
                    <h6 class="fw-bold small">รายชื่อพนักงานในระบบ</h6>
                    <ul class="list-group list-group-flush small">
                        @if (users != null)
                        {
                            foreach (var u in users)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span><strong>@u.EmployeeCode</strong> - @u.FullName</span>
                                    <span class="badge bg-secondary">@u.Role</span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">🎫 กำหนด / แก้ไขสิทธิวันลาประจำปี</div>
                <div class="card-body">
                    <form asp-action="SaveBalance" method="post" class="row g-2 mb-3">
                        <div class="col-12 col-sm-4">
                            <label class="form-label small fw-bold">พนักงาน</label>
                            <select name="UserId" class="form-select" required>
                                @if (users != null)
                                {
                                    foreach (var u in users)
                                    {
                                        <option value="@u.Id">@u.EmployeeCode - @u.FullName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6 col-sm-3">
                            <label class="form-label small fw-bold">ประเภทการลา</label>
                            <select name="LeaveType" class="form-select">
                                <option value="ลาพักร้อน">ลาพักร้อน</option>
                                <option value="ลากิจ">ลากิจ</option>
                                <option value="ลาป่วย">ลาป่วย</option>
                            </select>
                        </div>
                        <div class="col-3 col-sm-2">
                            <label class="form-label small fw-bold">ปี</label>
                            <input type="number" name="Year" class="form-control" value="@DateTime.Now.Year" required />
                        </div>
                        <div class="col-3 col-sm-3">
                            <label class="form-label small fw-bold">จำนวนวัน</label>
                            <input type="number" name="TotalDays" class="form-control" min="0" max="365" value="6" required />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100 mt-1">💾 บันทึกสิทธิวันลา</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>พนักงาน</th>
                                    <th>ปี</th>
                                    <th>ประเภท</th>
                                    <th class="text-center">สิทธิทั้งหมด (วัน)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (balances != null)
                                {
                                    foreach (var b in balances)
                                    {
                                        <tr>
                                            <td>@b.User?.FullName</td>
                                            <td>@b.Year</td>
                                            <td>@b.LeaveType</td>
                                            <td class="text-center fw-bold">@b.TotalDays</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>