@model LeaveSystem.Models.LeaveRequest
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "ยื่นใบลาใหม่";
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var empCode = HttpContextAccessor.HttpContext?.Session.GetString("EmployeeCode");
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-modern p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-4 p-3 fs-4">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">แบบฟอร์มยื่นใบลา</h4>
                    <p class="text-muted small mb-0">ระบบจะคำนวณเฉพาะวันจันทร์ - ศุกร์ให้อัตโนมัติ</p>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 small d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="UserId" value="@userId" />

                <div class="bg-light rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><i class="bi bi-person-check me-1"></i> ผู้ยื่นคำขอลา</span>
                    <span class="fw-bold text-dark">@empCode — @fullName</span>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">ประเภทการลา</label>
                    <select asp-for="LeaveType" class="form-select form-select-lg rounded-3 fs-6" required>
                        <option value="ลาพักร้อน">☀️ ลาพักร้อน</option>
                        <option value="ลากิจ">💼 ลากิจ</option>
                        <option value="ลาป่วย">🩺 ลาป่วย</option>
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary">วันที่เริ่มลา</label>
                        <input asp-for="StartDate" type="date" class="form-control rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-secondary">วันที่สิ้นสุด</label>
                        <input asp-for="EndDate" type="date" class="form-control rounded-3" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">เหตุผลการลา</label>
                    <textarea asp-for="Reason" class="form-control rounded-3" rows="3" placeholder="ระบุรายละเอียดหรือเหตุผลการลา..." required></textarea>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-light border btn-rounded px-4">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary btn-rounded flex-fill shadow-sm">
                        <i class="bi bi-send me-1"></i> ส่งคำขอลา
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>